# =====================================================================
# TeXGuardIA - Variáveis de Ambiente e Configuração (Modelo Educacional)
# =====================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para '.env': cp .env.example .env
# 2. Preencha com sua própria chave de API conforme o provedor desejado.
# 3. NUNCA envie o arquivo '.env' para o GitHub ou controle de versão!
# =====================================================================

# Provedor de IA preferido: 'openrouter', 'alibaba', 'gemini', 'openai' ou 'offline'
AI_PROVIDER=openrouter

# ---------------------------------------------------------------------
# OpenRouter (Modelos Gratuitos e Comerciais)
# Obtenha sua chave em: https://openrouter.ai/keys
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------------
# Alibaba Cloud Model Studio (Qwen / DashScope)
# Obtenha sua chave em: https://bailian.console.alibabacloud.com/
# ---------------------------------------------------------------------
ALIBABA_API_KEY=sua_chave_alibaba_aqui
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALIBABA_MODEL=qwen-plus

# ---------------------------------------------------------------------
# Google Gemini (Google AI Studio)
# Obtenha sua chave em: https://aistudio.google.com/
# ---------------------------------------------------------------------
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------
# OpenAI Oficial (Opcional)
# Obtenha sua chave em: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------
# Parâmetros Gerais e Operacionais
# ---------------------------------------------------------------------
OUTPUT_DIR=relatorios
NETWORK_TIMEOUT=5
LOG_LEVEL=INFO
